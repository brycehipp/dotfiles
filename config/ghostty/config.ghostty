# Config generated by Ghostty Config

copy-on-select = false
theme = Dracula
bold-is-bright = true
background = #111111
foreground = #eaeaea
selection-background = #424242
selection-foreground = #eaeaea
palette = 0=#000000
palette = 1=#d54e53
palette = 2=#b9ca4a
palette = 3=#e7c547
palette = 4=#7aa6da
palette = 5=#c397d8
palette = 6=#70c0b1
palette = 7=#ffffff
#palette = 8=#000000 # this causes mocha test output to be all black and not readable
palette = 15=#ffffff
cursor-color = #eaeaea
cursor-text = #000000
cursor-style = bar
font-size = 14
font-thicken = true
font-family = Maple Mono NF
keybind = super+shift+left_bracket=goto_split:left
keybind = super+shift+right_bracket=goto_split:right
keybind = super+alt+right=next_tab
keybind = super+alt+left=previous_tab
mouse-hide-while-typing = true
macos-titlebar-style = tabs

# needed to get sudo working - https://ghostty.org/docs/help/terminfo
shell-integration-features = sudo
